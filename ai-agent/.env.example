CHUNK_TOKEN_SIZE=800
CHUNK_TOKEN_OVERLAP=120
EMBEDDING_BATCH_SIZE=32
DEFAULT_TOP_K=6
MAX_TOP_K=12
RETRIEVAL_SCORE_THRESHOLD=0.35
MEMORY_TOKEN_LIMIT=6000
