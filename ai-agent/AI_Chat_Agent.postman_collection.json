            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Tell me a fun fact about Python programming\",\n  \"model\": \"gpt-4o-mini\"\n}"
        },
        "url": {
          "raw": "http://localhost:8001/chat",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8001",
          "path": ["chat"]
