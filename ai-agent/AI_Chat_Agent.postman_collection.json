      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Can you explain more about that?\",\n  \"conversation_history\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"What is FastAPI?\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"FastAPI is a modern, fast (high-performance) web framework for building APIs with Python 3.7+ based on standard Python type hints.\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "http://localhost:8001/chat",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8001",
          "path": ["chat"]
        },
        "description": "Send a message with conversation history for context"
      },
      "response": []
    },
    {
      "name": "Chat with Different Model",
      "request": {
        "method": "POST",
        "header": [
          {
