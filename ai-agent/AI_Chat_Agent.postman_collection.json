    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8001/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8001",
          "path": [""]
        },
        "description": "Check if the API is running"
      },
      "response": []
    },
    {
      "name": "Simple Chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"What is FastAPI?\"\n}"
        },
        "url": {
          "raw": "http://localhost:8001/chat",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8001",
          "path": ["chat"]
        },
        "description": "Send a simple message to the AI without conversation history"
      },
      "response": []
    },
    {
